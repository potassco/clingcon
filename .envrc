if [[ -f ".venv/bin/activate" ]]; then
    source .venv/bin/activate
fi

export CFLAGS="-Wall -Wextra"

for version in 22 20; do
    if command -v clang++-${version} >/dev/null 2>&1; then
        export CC=clang-${version}
        export CXX=clang++-${version}
        export CXXFLAGS="-stdlib=libc++ $CFLAGS"
        break
    fi
done

export POTASSCO_PREFIX="${HOME}/.local/opt/potassco"

python_version=$(python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
clingo_path="${POTASSCO_PREFIX}/debug/lib/python${python_version}/site-packages"

export PYTHONPATH="${PWD}/build/debug/bin/python:${clingo_path}:${PYTHONPATH}"
export PATH="${PWD}/build/debug/bin:${PATH}"
