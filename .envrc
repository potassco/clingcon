if [[ -f ".venv/bin/activate" ]]; then
    source .venv/bin/activate
fi

python_version=$(python -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
clingo_path="${HOME}/.local/opt/potassco/debug/lib/python${python_version}/site-packages"
export PYTHONPATH="${PWD}/build/debug/bin/python"
if [[ -d "${clingo_path}" ]]; then
    export PYTHONPATH="${clingo_path}:${PYTHONPATH}"
fi
